{
  "name": "dsh-deepseek-chat-embed",
  "version": "0.1.0",
  "description": "在 DeepSeek Harness (dsh) 桌面端内嵌 chat.deepseek.com，提供双入口聊天面板与持久登录会话。",
  "type": "module",
  "main": "src/client.js",
  "exports": {
    ".": "./src/client.js",
    "./client": "./dist/dsh-deepseek-chat-embed.bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "dist",
    "cordis.yml",
    "assets",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client-bundle.mjs",
    "prepare": "node scripts/build-client-bundle.mjs",
    "check": "node --check src/client.js && node scripts/build-client-bundle.mjs --verify",
    "test:entries": "node test/entries/verify.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "deepseek-chat",
    "webview"
  ],
  "author": "realguan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realguan/dsh-deepseek-chat-embed.git"
  },
  "homepage": "https://github.com/realguan/dsh-deepseek-chat-embed#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.x"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
